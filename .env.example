DATABASE_URL="postgresql://clocking:clocking@localhost:5432/clocking?schema=public"
AUTH_SECRET="generate-a-32-byte-secret"
# HMAC pepper for kiosk PINs (use a distinct secret from AUTH_SECRET in production)
PIN_PEPPER="generate-a-second-32-byte-secret"
# Optional: IANA timezone for midnight auto-close and reporting
ORG_TIMEZONE="Europe/London"
# Daily/weekly overtime thresholds (hours)
OVERTIME_DAILY_HOURS="8"
OVERTIME_WEEKLY_HOURS="40"
# Optional magic-link email (Auth.js Email provider)
# AUTH_URL="http://localhost:3000"
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Harvest Clock <noreply@example.com>"
